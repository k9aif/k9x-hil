# K9X HIL internal instance (ubuntu_internal/build-run.sh).
# Start from a copy of .env (same PostgreSQL server, Kafka, S3), then set:
HIL_PROFILE=internal
# Optional badge next to the logo; unset = no badge
HIL_BADGE=Internal
POSTGRES_SCHEMA=k9hil_internal
HIL_CONSUMER_GROUP=k9x-hil-internal-ingest
# openssl rand -hex 32 (must differ from the public instance's)
JWT_SECRET_KEY=
HIL_ADMIN_EMAIL=ravinatarajan@k9x.ai
HIL_ADMIN_PASSWORD=
