# K9X HIL dedicated instance for DAS (ubuntu_instance/build-run.sh all das).
# Start from a copy of .env (same PostgreSQL server, Kafka, S3), then set or replace:
HIL_INSTANCE=das
HIL_INSTANCE_PORT=8116
# Badge next to the logo
HIL_BADGE=DAS
# Its own schema and Kafka consumer group (never k9hil / k9x-hil-ingest)
POSTGRES_SCHEMA=k9hil_das
HIL_CONSUMER_GROUP=k9x-hil-das-ingest
# openssl rand -hex 32 (must differ from .env and .env.internal)
JWT_SECRET_KEY=
# The instance admin; the password is reset to this on every start
HIL_ADMIN_EMAIL=admin@k9x.ai
HIL_ADMIN_PASSWORD=
# Remove from this file: HIL_PROFILE, HIL_PUBLIC_ADMIN_PASSWORD
